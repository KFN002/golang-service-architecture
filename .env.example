# Copy to .env next to deploy/docker-compose.yml (compose reads it) or export
# in your shell for local `make run-*`. NEVER commit a real .env.

# ---- credentials (change all of these outside a laptop) ---------------------
PG_USER=calc
PG_PASS=calcpass
AUDIT_PG_USER=audit
AUDIT_PG_PASS=auditpass
RABBIT_USER=calc
RABBIT_PASS=calcpass
GRAFANA_ADMIN_PASS=admin

# ---- service knobs (env-first config; defaults shown) -----------------------
# APP_ENV=dev                  # dev = colored console logs; prod = sampled JSON
# LOG_LEVEL=info
# OTEL_ENABLED=true
# OTEL_ENDPOINT=localhost:4317
# PPROF_ENABLED=false

# Orchestrator
# HTTP_PORT=8080
# GRPC_PORT=50051
# RELAY_INTERVAL=100ms         # outbox poll cadence
# RELAY_BATCH=128
# PREFETCH=64
# RATE_RPS=50                  # per-client HTTP/gRPC rate limit
# RATE_BURST=100

# Agent — the demo latencies make distribution visible; zero them to benchmark
# POOL_MIN=2
# POOL_MAX=32
# POOL_IDLE_TIMEOUT=15s
# OP_LATENCY_ADD=1s
# OP_LATENCY_SUB=1s
# OP_LATENCY_MUL=2s
# OP_LATENCY_DIV=2s

# Audit
# BATCH_MAX_SIZE=500           # group-commit size
# BATCH_MAX_WAIT=150ms         # ... or flush interval
# INGEST_BULKHEAD=64           # concurrent AMQP ingest slots
# WRITE_BULKHEAD=16            # concurrent gRPC write slots
# QUERY_CACHE_TTL=3s
# PARTITIONS_AHEAD=3           # daily partitions pre-created
